{
  "name": "claudial",
  "version": "0.8.0",
  "description": "Live football for your teams in the status bar of Claude Code and Cursor CLI, plus a terminal dashboard with goal and red-card takeovers",
  "type": "module",
  "bin": {
    "claudial": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.tsx",
    "test": "vitest run",
    "prepublishOnly": "node scripts/check-release.mjs && npm run build"
  },
  "dependencies": {
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "football",
    "premier-league",
    "worldcup",
    "tui",
    "cli",
    "soccer",
    "live-scores",
    "ink",
    "cursor",
    "vscode",
    "antigravity",
    "statusline"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lefProg/claudial.git"
  },
  "homepage": "https://github.com/lefProg/claudial#readme",
  "bugs": "https://github.com/lefProg/claudial/issues",
  "author": "lefProg"
}
